# ==========================================
# AirCrewOps / Nova Air — Strict .gitignore
# ==========================================

# Local-only Markdown documentation (NEVER pushed to remote)
*.md
**/*.md
README.md
AGENTS.md
AI_CONTEXT.md
docs/

# Local-only Agent rules, skills, and prompts (NEVER pushed to remote)
.agents/
.agents/**
skills/
**/skills/

# Python environments, bytecode, and virtual environments
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing, coverage, and linting caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Frontend dependencies, build artifacts, and caches
frontend/node_modules/
node_modules/
frontend/dist/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local SQLite databases, journals, and WAL files
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
data/*.db
data/*.sqlite3

# Benchmark generated scratch files & results
benchmarks/generated/
benchmarks/latest_benchmark_results.json

# Environment variables, secrets, keys, and certificates
.env
.env.*
*.pem
*.key

# Operating System & IDE artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# AI agent local brain and temporary IDE metadata
.gemini/
