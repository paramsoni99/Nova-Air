# ==========================================
# AirCrewOps / Nova-Air — .gitignore
# ==========================================

# Internal AI context, skill definitions, and Markdown documentation
*.md
.agents/
**/.agents/
skills/
**/skills/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Linting
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Node & Frontend
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Databases & Runtime Data
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite3

# Environment variables & secrets
.env
.env.*
!.env.example

# Operating System & Editors
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# IDE / Agent specific artifacts
.gemini/
